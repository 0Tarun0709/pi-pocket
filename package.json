    "dompurify": "^3.4.18",
    "marked": "^18.2.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "jsdom": "^31.0.1",
    "jsqr": "^1.4.0",
    "typescript": "^5.9.3"
  }
}

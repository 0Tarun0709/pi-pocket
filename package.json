{
  "name": "pi-pocket",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A local web interface for a running Pi session",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0Tarun0709/pi-pocket.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "extensions/",
    "web/",
    "README.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/pocket"
    ]
